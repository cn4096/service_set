#!/usr/bin/env bash
# service.set — 把当前目录下的可执行文件注册为 systemd 自启动服务
# 用法: service.set [选项] <bin-name>
#
# 选项:
#   -i, --install          复制程序到 INSTALL_DIR（临时覆盖 INSTALL_APP=false）
#   -I, --no-install       保留程序在源目录（临时覆盖 INSTALL_APP=true）
#   -d, --dir <path>       临时指定安装目录（默认 /usr/local/bin）
#   -h, --help             显示此帮助

set -euo pipefail

# ── 配置项 ───────────────────────────────────────────────────────────────────
# 是否将程序复制到 INSTALL_DIR（/usr/local/bin）。
# false：程序保留在源目录，ExecStart 指向原始路径（默认）
# true ：复制到 INSTALL_DIR，ExecStart 指向安装后路径
# 命令行选项 -i / -I 可临时覆盖此设置，优先级高于此处配置
INSTALL_APP=false
INSTALL_DIR="/usr/local/bin"

# ── 颜色输出 ────────────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; NC='\033[0m'
info()  { echo -e "${CYAN}[INFO]${NC}  $*"; }
ok()    { echo -e "${GREEN}[OK]${NC}    $*"; }
warn()  { echo -e "${YELLOW}[WARN]${NC}  $*"; }
die()   { echo -e "${RED}[ERROR]${NC} $*" >&2; exit 1; }
usage() {
    echo -e "用法: service.set [选项] <bin-name>"
    echo -e ""
    echo -e "选项:"
    echo -e "  ${CYAN}-i, --install${NC}          复制程序到安装目录后注册服务"
    echo -e "  ${CYAN}-I, --no-install${NC}       程序保留源目录注册服务"
    echo -e "  ${CYAN}-d, --dir <path>${NC}       临时指定安装目录（默认 /usr/local/bin）"
    echo -e "  ${CYAN}-h, --help${NC}             显示此帮助"
    echo -e ""
    echo -e "示例:"
    echo -e "  service.set myapp                # 源目录运行（默认）"
    echo -e "  service.set -i myapp             # 复制到 /usr/local/bin 再注册"
    echo -e "  service.set -i -d /opt myapp     # 复制到 /opt 再注册"
}

# ── 解析命令行参数 ────────────────────────────────────────────────────────────
BIN_NAME=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -i|--install)    INSTALL_APP=true;  shift ;;
        -I|--no-install) INSTALL_APP=false; shift ;;
        -d|--dir)
            [[ $# -ge 2 ]] || die "--dir 需要指定一个目录路径"
            INSTALL_DIR="$2"; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        -*) die "未知选项: $1（使用 -h 查看帮助）" ;;
        *)  BIN_NAME="$1"; shift ;;
    esac
done

[[ -n "$BIN_NAME" ]] || { usage; echo ""; die "缺少 <bin-name> 参数"; }

# ── 权限检查 ─────────────────────────────────────────────────────────────────
[[ $EUID -eq 0 ]] || die "请以 root 身份运行（sudo service.set $BIN_NAME）"

# ── 确认可执行文件存在 ────────────────────────────────────────────────────────
SRC_PATH="$(pwd)/${BIN_NAME}"
[[ -f "$SRC_PATH" ]] || die "在当前目录中找不到文件: $SRC_PATH"
[[ -x "$SRC_PATH" ]] || { warn "$BIN_NAME 没有可执行权限，正在添加..."; chmod +x "$SRC_PATH"; }

# ── 决定 ExecStart 路径 ───────────────────────────────────────────────────────
if [[ "$INSTALL_APP" == true ]]; then
    [[ -d "$INSTALL_DIR" ]] || { warn "目录 $INSTALL_DIR 不存在，正在创建..."; mkdir -p "$INSTALL_DIR"; }
    EXEC_PATH="${INSTALL_DIR}/${BIN_NAME}"
    if [[ "$SRC_PATH" != "$EXEC_PATH" ]]; then
        info "复制 $BIN_NAME → $EXEC_PATH"
        cp -f "$SRC_PATH" "$EXEC_PATH"
        chmod +x "$EXEC_PATH"
    fi
    ok "程序已安装到 $EXEC_PATH"
else
    EXEC_PATH="$SRC_PATH"
    info "程序保留在源目录: $EXEC_PATH（INSTALL_APP=false）"
fi

# ── 生成 systemd unit 文件 ────────────────────────────────────────────────────
SERVICE_NAME="${BIN_NAME}"
UNIT_FILE="/etc/systemd/system/${SERVICE_NAME}.service"

info "生成 systemd 服务文件: $UNIT_FILE"
cat > "$UNIT_FILE" <<EOF
[Unit]
Description=${SERVICE_NAME} service (managed by service.set)
After=network.target

[Service]
Type=simple
ExecStart=${EXEC_PATH}
WorkingDirectory=$(dirname "$EXEC_PATH")
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=${SERVICE_NAME}

[Install]
WantedBy=multi-user.target
EOF

# ── 启用并启动服务 ────────────────────────────────────────────────────────────
info "重新加载 systemd 配置..."
systemctl daemon-reload

info "设置 ${SERVICE_NAME} 开机自启动..."
systemctl enable "${SERVICE_NAME}.service"

info "立即启动 ${SERVICE_NAME}..."
systemctl restart "${SERVICE_NAME}.service"

# ── 显示状态 ──────────────────────────────────────────────────────────────────
echo ""
ok "服务 [${SERVICE_NAME}] 已成功注册并启动！"
echo ""
echo -e "  ${CYAN}常用命令:${NC}"
echo -e "    查看状态   →  systemctl status  ${SERVICE_NAME}"
echo -e "    查看日志   →  journalctl -fu    ${SERVICE_NAME}"
echo -e "    停止服务   →  systemctl stop    ${SERVICE_NAME}"
echo -e "    禁用自启   →  systemctl disable ${SERVICE_NAME}"
echo ""
systemctl --no-pager status "${SERVICE_NAME}.service" || true
