#!/bin/sh
# service.set — 把当前目录下的可执行文件注册为自启动服务
# 支持系统: 标准 Linux (systemd) / OpenWrt (procd)
# 用法: service.set [选项] <bin-name>
#
# 选项:
#   -i, --install          复制程序到 INSTALL_DIR（临时覆盖 INSTALL_APP=false）
#   -I, --no-install       保留程序在源目录（临时覆盖 INSTALL_APP=true）
#   -d, --dir <path>       临时指定安装目录
#   -h, --help             显示此帮助

set -eu

# ── 颜色输出 ─────────────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; NC='\033[0m'
info()  { printf "${CYAN}[INFO]${NC}  %s\n" "$*"; }
ok()    { printf "${GREEN}[OK]${NC}    %s\n" "$*"; }
warn()  { printf "${YELLOW}[WARN]${NC}  %s\n" "$*"; }
die()   { printf "${RED}[ERROR]${NC} %s\n" "$*" >&2; exit 1; }

# ── 系统检测 ──────────────────────────────────────────────────────────────────
detect_system() {
    if [ -f /etc/openwrt_release ]; then
        echo "procd"
    elif command -v systemctl > /dev/null 2>&1; then
        echo "systemd"
    else
        die "不支持的系统：未检测到 systemd 或 OpenWrt/procd"
    fi
}

SYS_TYPE="$(detect_system)"

# ── 配置项（按系统设定默认安装目录）────────────────────────────────────────
INSTALL_APP=false
if [ "$SYS_TYPE" = "procd" ]; then
    INSTALL_DIR="/usr/bin"
else
    INSTALL_DIR="/usr/local/bin"
fi

# ── 帮助信息 ──────────────────────────────────────────────────────────────────
usage() {
    printf "用法: service.set [选项] <bin-name>\n"
    printf "\n"
    printf "支持系统: systemd (标准 Linux) / procd (OpenWrt)\n"
    printf "当前检测: %s\n" "$SYS_TYPE"
    printf "\n"
    printf "选项:\n"
    printf "  ${CYAN}-i, --install${NC}          复制程序到安装目录后注册服务\n"
    printf "  ${CYAN}-I, --no-install${NC}       程序保留源目录注册服务\n"
    printf "  ${CYAN}-d, --dir <path>${NC}       临时指定安装目录（默认 %s）\n" "$INSTALL_DIR"
    printf "  ${CYAN}-h, --help${NC}             显示此帮助\n"
    printf "\n"
    printf "示例:\n"
    printf "  service.set myapp                # 源目录运行（默认）\n"
    printf "  service.set -i myapp             # 复制到默认目录再注册\n"
    printf "  service.set -i -d /opt myapp     # 复制到 /opt 再注册\n"
}

# ── 解析命令行参数 ────────────────────────────────────────────────────────────
BIN_NAME=""
while [ $# -gt 0 ]; do
    case "$1" in
        -i|--install)    INSTALL_APP=true;  shift ;;
        -I|--no-install) INSTALL_APP=false; shift ;;
        -d|--dir)
            [ $# -ge 2 ] || die "--dir 需要指定一个目录路径"
            INSTALL_DIR="$2"; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        -*) die "未知选项: $1（使用 -h 查看帮助）" ;;
        *)  BIN_NAME="$1"; shift ;;
    esac
done

[ -n "$BIN_NAME" ] || { usage; printf "\n"; die "缺少 <bin-name> 参数"; }

# ── 权限检查 ──────────────────────────────────────────────────────────────────
[ "$(id -u)" -eq 0 ] || die "请以 root 身份运行（sudo service.set $BIN_NAME）"

# ── 确认可执行文件存在 ────────────────────────────────────────────────────────
SRC_PATH="$(pwd)/${BIN_NAME}"
[ -f "$SRC_PATH" ] || die "在当前目录中找不到文件: $SRC_PATH"
[ -x "$SRC_PATH" ] || { warn "$BIN_NAME 没有可执行权限，正在添加..."; chmod +x "$SRC_PATH"; }

# ── 决定实际执行路径 ──────────────────────────────────────────────────────────
if [ "$INSTALL_APP" = true ]; then
    [ -d "$INSTALL_DIR" ] || { warn "目录 $INSTALL_DIR 不存在，正在创建..."; mkdir -p "$INSTALL_DIR"; }
    EXEC_PATH="${INSTALL_DIR}/${BIN_NAME}"
    if [ "$SRC_PATH" != "$EXEC_PATH" ]; then
        info "复制 $BIN_NAME → $EXEC_PATH"
        cp -f "$SRC_PATH" "$EXEC_PATH"
        chmod +x "$EXEC_PATH"
    fi
    ok "程序已安装到 $EXEC_PATH"
else
    EXEC_PATH="$SRC_PATH"
    info "程序保留在源目录: $EXEC_PATH（INSTALL_APP=false）"
fi

SERVICE_NAME="${BIN_NAME}"

# ════════════════════════════════════════════════════════════════════════════
# ── systemd 注册 ─────────────────────────────────────────────────────────────
# ════════════════════════════════════════════════════════════════════════════
register_systemd() {
    UNIT_FILE="/etc/systemd/system/${SERVICE_NAME}.service"
    info "检测到 systemd 系统，生成 unit 文件: $UNIT_FILE"

    cat > "$UNIT_FILE" <<EOF
[Unit]
Description=${SERVICE_NAME} service (managed by service.set)
After=network.target

[Service]
Type=simple
ExecStart=${EXEC_PATH}
WorkingDirectory=$(dirname "$EXEC_PATH")
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=${SERVICE_NAME}

[Install]
WantedBy=multi-user.target
EOF

    info "重新加载 systemd 配置..."
    systemctl daemon-reload

    info "设置 ${SERVICE_NAME} 开机自启动..."
    systemctl enable "${SERVICE_NAME}.service"

    info "立即启动 ${SERVICE_NAME}..."
    systemctl restart "${SERVICE_NAME}.service"

    printf "\n"
    ok "服务 [${SERVICE_NAME}] 已成功注册并启动！"
    printf "\n"
    printf "  ${CYAN}常用命令:${NC}\n"
    printf "    查看状态   →  systemctl status  %s\n" "$SERVICE_NAME"
    printf "    查看日志   →  journalctl -fu    %s\n" "$SERVICE_NAME"
    printf "    停止服务   →  systemctl stop    %s\n" "$SERVICE_NAME"
    printf "    禁用自启   →  systemctl disable %s\n" "$SERVICE_NAME"
    printf "\n"
    systemctl --no-pager status "${SERVICE_NAME}.service" || true
}

# ════════════════════════════════════════════════════════════════════════════
# ── procd 注册 ───────────────────────────────────────────────────────────────
# ════════════════════════════════════════════════════════════════════════════
register_procd() {
    INIT_FILE="/etc/init.d/${SERVICE_NAME}"
    info "检测到 OpenWrt/procd 系统，生成 init 脚本: $INIT_FILE"

    cat > "$INIT_FILE" <<EOF
#!/bin/sh /etc/rc.common
# ${SERVICE_NAME} init script — managed by service.set

USE_PROCD=1
START=95
STOP=05

PROG=${EXEC_PATH}

start_service() {
    procd_open_instance
    procd_set_param command "\$PROG"
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    killall -q "\$(basename \$PROG)" 2>/dev/null || true
}

reload_service() {
    stop_service
    start_service
}
EOF

    chmod +x "$INIT_FILE"

    info "设置 ${SERVICE_NAME} 开机自启动..."
    "$INIT_FILE" enable

    info "立即启动 ${SERVICE_NAME}..."
    "$INIT_FILE" start

    printf "\n"
    ok "服务 [${SERVICE_NAME}] 已成功注册并启动！"
    printf "\n"
    printf "  ${CYAN}常用命令:${NC}\n"
    printf "    查看状态   →  /etc/init.d/%s status\n"  "$SERVICE_NAME"
    printf "    查看日志   →  logread -e %s\n"           "$SERVICE_NAME"
    printf "    停止服务   →  /etc/init.d/%s stop\n"    "$SERVICE_NAME"
    printf "    禁用自启   →  /etc/init.d/%s disable\n" "$SERVICE_NAME"
    printf "    重启服务   →  /etc/init.d/%s restart\n" "$SERVICE_NAME"
    printf "\n"
    "$INIT_FILE" status || true
}

# ── 按系统类型执行注册 ────────────────────────────────────────────────────────
info "当前系统: $SYS_TYPE"
if [ "$SYS_TYPE" = "systemd" ]; then
    register_systemd
else
    register_procd
fi
