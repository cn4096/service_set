#!/bin/sh
# op_service.set — 把当前目录下的可执行文件注册为 OpenWrt procd 自启动服务
# 用法: op_service.set [选项] <bin-name>
#
# 选项:
#   -i, --install          复制程序到 INSTALL_DIR（临时覆盖 INSTALL_APP=false）
#   -I, --no-install       保留程序在源目录（临时覆盖 INSTALL_APP=true）
#   -d, --dir <path>       临时指定安装目录（默认 /usr/bin）
#   -h, --help             显示此帮助

# ── 配置项 ───────────────────────────────────────────────────────────────────
# 是否将程序复制到 INSTALL_DIR（/usr/bin）。
# false：程序保留在源目录，ExecStart 指向原始路径（默认）
# true ：复制到 INSTALL_DIR，ExecStart 指向安装后路径
# 命令行选项 -i / -I 可临时覆盖此设置，优先级高于此处配置
INSTALL_APP=false
INSTALL_DIR="/usr/bin"

# ── 颜色输出 ─────────────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; NC='\033[0m'
info()  { printf "${CYAN}[INFO]${NC}  %s\n" "$*"; }
ok()    { printf "${GREEN}[OK]${NC}    %s\n" "$*"; }
warn()  { printf "${YELLOW}[WARN]${NC}  %s\n" "$*"; }
die()   { printf "${RED}[ERROR]${NC} %s\n" "$*" >&2; exit 1; }

usage() {
    printf "用法: op_service.set [选项] <bin-name>\n"
    printf "\n"
    printf "选项:\n"
    printf "  ${CYAN}-i, --install${NC}          复制程序到安装目录后注册服务\n"
    printf "  ${CYAN}-I, --no-install${NC}       程序保留源目录注册服务\n"
    printf "  ${CYAN}-d, --dir <path>${NC}       临时指定安装目录（默认 /usr/bin）\n"
    printf "  ${CYAN}-h, --help${NC}             显示此帮助\n"
    printf "\n"
    printf "示例:\n"
    printf "  op_service.set myapp                # 源目录运行（默认）\n"
    printf "  op_service.set -i myapp             # 复制到 /usr/bin 再注册\n"
    printf "  op_service.set -i -d /opt myapp     # 复制到 /opt 再注册\n"
}

# ── 解析命令行参数 ────────────────────────────────────────────────────────────
BIN_NAME=""
while [ $# -gt 0 ]; do
    case "$1" in
        -i|--install)    INSTALL_APP=true;  shift ;;
        -I|--no-install) INSTALL_APP=false; shift ;;
        -d|--dir)
            [ $# -ge 2 ] || die "--dir 需要指定一个目录路径"
            INSTALL_DIR="$2"; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        -*) die "未知选项: $1（使用 -h 查看帮助）" ;;
        *)  BIN_NAME="$1"; shift ;;
    esac
done

[ -n "$BIN_NAME" ] || { usage; printf "\n"; die "缺少 <bin-name> 参数"; }

# ── 权限检查 ──────────────────────────────────────────────────────────────────
[ "$(id -u)" -eq 0 ] || die "请以 root 身份运行（sudo op_service.set $BIN_NAME）"

# ── 确认可执行文件存在 ────────────────────────────────────────────────────────
SRC_PATH="$(pwd)/${BIN_NAME}"
[ -f "$SRC_PATH" ] || die "在当前目录中找不到文件: $SRC_PATH"
[ -x "$SRC_PATH" ] || { warn "$BIN_NAME 没有可执行权限，正在添加..."; chmod +x "$SRC_PATH"; }

# ── 决定实际执行路径 ──────────────────────────────────────────────────────────
if [ "$INSTALL_APP" = true ]; then
    [ -d "$INSTALL_DIR" ] || { warn "目录 $INSTALL_DIR 不存在，正在创建..."; mkdir -p "$INSTALL_DIR"; }
    EXEC_PATH="${INSTALL_DIR}/${BIN_NAME}"
    if [ "$SRC_PATH" != "$EXEC_PATH" ]; then
        info "复制 $BIN_NAME → $EXEC_PATH"
        cp -f "$SRC_PATH" "$EXEC_PATH"
        chmod +x "$EXEC_PATH"
    fi
    ok "程序已安装到 $EXEC_PATH"
else
    EXEC_PATH="$SRC_PATH"
    info "程序保留在源目录: $EXEC_PATH（INSTALL_APP=false）"
fi

# ── 生成 procd init 脚本 ──────────────────────────────────────────────────────
SERVICE_NAME="${BIN_NAME}"
INIT_FILE="/etc/init.d/${SERVICE_NAME}"
EXEC_DIR="$(dirname "$EXEC_PATH")"

info "生成 procd 服务脚本: $INIT_FILE"
cat > "$INIT_FILE" <<EOF
#!/bin/sh /etc/rc.common
# ${SERVICE_NAME} init script — managed by op_service.set

USE_PROCD=1
START=95
STOP=05

PROG=${EXEC_PATH}

start_service() {
    procd_open_instance
    procd_set_param command "\$PROG"
    procd_set_param respawn   # 崩溃后自动重启
    procd_set_param stdout 1  # 日志重定向到 logd
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    killall -q "\$(basename \$PROG)" 2>/dev/null || true
}

reload_service() {
    stop_service
    start_service
}
EOF

chmod +x "$INIT_FILE"

# ── 启用并启动服务 ────────────────────────────────────────────────────────────
info "设置 ${SERVICE_NAME} 开机自启动..."
"$INIT_FILE" enable

info "立即启动 ${SERVICE_NAME}..."
"$INIT_FILE" start

# ── 显示结果 ──────────────────────────────────────────────────────────────────
printf "\n"
ok "服务 [${SERVICE_NAME}] 已成功注册并启动！"
printf "\n"
printf "  ${CYAN}常用命令:${NC}\n"
printf "    查看状态   →  /etc/init.d/${SERVICE_NAME} status\n"
printf "    查看日志   →  logread -e ${SERVICE_NAME}\n"
printf "    停止服务   →  /etc/init.d/${SERVICE_NAME} stop\n"
printf "    禁用自启   →  /etc/init.d/${SERVICE_NAME} disable\n"
printf "    重启服务   →  /etc/init.d/${SERVICE_NAME} restart\n"
printf "\n"
"$INIT_FILE" status || true
